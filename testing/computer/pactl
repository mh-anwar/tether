#!/usr/bin/env python3
import json, os, sys
from pathlib import Path
root=Path(os.environ['FAKE_COMPUTER_DIR'])
state=root/'volume.json'
v=json.loads(state.read_text()) if state.exists() else {'volume':42,'muted':False}
a=sys.argv[1:]
with (root/'calls.log').open('a') as f: f.write('pactl '+' '.join(a)+'\n')
if a==['--format=json','list','sinks']:
 print(json.dumps([{'name':'test-sink','description':'Test speakers','volume':{'front-left':{'value_percent':f"{v['volume']}%"}},'mute':v['muted']}]))
elif a==['get-default-sink']: print('test-sink')
elif a[:1]==['set-sink-volume']: v['volume']=int(a[2].rstrip('%'))
elif a[:1]==['set-sink-mute']: v['muted']=a[2]=='1'
elif a[:1]!=['set-default-sink']: sys.exit(1)
state.write_text(json.dumps(v))
